# =============================================================================
# Environment variables template for go-okx.
#
# Usage:
#   1. Copy this file to the same directory without the .example suffix:
#        cp .env.example .env
#   2. Fill in the real values (in .env only, not in .env.example).
#   3. Run any example via scripts/run.sh or manually:
#        set -a; source .env; set +a
#        go run ./examples/simple-trade
#
# WARNING:
#   - .env is listed in .gitignore — it must NEVER be committed.
#   - If accidentally committed — revoke the key on OKX and create a new one.
#   - Never share the values from .env with anyone. Including AI chat.
# =============================================================================

# --- Required variables for private calls (Trading, Account, WS-private) ---

# API Key issued by OKX. UUID format.
OKX_API_KEY=

# Secret Key (HMAC secret). Hexadecimal string.
OKX_SECRET_KEY=

# Passphrase chosen when creating the key on OKX.
OKX_PASSPHRASE=

# --- Additional flags ---

# Guard against accidentally running trading examples against production.
# Without OKX_ALLOW_LIVE=1 examples/simple-trade will refuse to send orders.
OKX_ALLOW_LIVE=0
