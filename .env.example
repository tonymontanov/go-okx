# =============================================================================
# Шаблон переменных окружения для go-okx.
#
# Использование:
#   1. Скопируйте этот файл рядом, без суффикса .example:
#        cp .env.example .env
#   2. Заполните реальные значения (только в .env, не в .env.example).
#   3. Запустите любой пример через scripts/run.sh либо вручную:
#        set -a; source .env; set +a
#        go run ./examples/simple-trade
#
# ВНИМАНИЕ:
#   - .env находится в .gitignore — он НИКОГДА не должен попадать в коммиты.
#   - Если случайно закоммитили — удалите ключ на OKX и создайте новый.
#   - Никому не показывайте значения из .env. Никому. Включая чат с AI.
# =============================================================================

# --- Обязательные переменные для приватных вызовов (Trading, Account, WS-private) ---

# API Key, выданный OKX. Формат UUID.
OKX_API_KEY=

# Secret Key (HMAC-секрет). Шестнадцатеричная строка.
OKX_SECRET_KEY=

# Passphrase, придуманный при создании ключа на OKX.
OKX_PASSPHRASE=

# --- Дополнительные флаги ---

# Защита от случайного запуска торговых примеров против production.
# Без OKX_ALLOW_LIVE=1 examples/simple-trade откажется отправлять ордера.
OKX_ALLOW_LIVE=0
